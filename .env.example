# ==========================================
# GCash -> AVA API Load Test Configuration
# ==========================================

# Base URL utama (dipakai jika pakai 1 API Gateway di UAT/Staging)
BASE_URL=http://localhost:8083

# Opsional untuk tes LOKAL tanpa API Gateway (jika tiap microservice beda port):
# Kosongkan jika semua lewat BASE_URL di atas.
# CUSTOMER_BASE_URL=http://localhost:8083
# UT_BASE_URL=http://localhost:8084
# TRANSACTION_BASE_URL=http://localhost:8091

# Prefix service (kosongkan jika langsung hit port service tanpa gateway)
CUSTOMER_PREFIX=/customer-service
UT_PREFIX=/ut-service
TRANSACTION_PREFIX=/transaction-service

# Saklar Auth BI-SNAP (false = tes lokal tanpa gateway, true = pakai token RSA + HMAC-SHA512)
ENABLE_AUTH=false

# Default Scenario: "daily" (rasio Req/day produksi), "peak" (p99.9 mix), "coincident", atau "smoke"
LOAD_SCENARIO=daily

# Default Multiplier bebas (contoh: 0.01 = 1%, 0.10 = 10%, 1.0 = 100%, 1.5 = 150%)
LOAD_MULTIPLIER=0.10

# Delay (detik) setelah setiap request endpoint di dalam User Journey
STEP_DELAY_MIN=1.0
STEP_DELAY_MAX=3.0

# Proporsi bobot tipe user: user baru (onboarding) vs user existing
NEW_USER_WEIGHT=2
EXISTING_USER_WEIGHT=8

# Header wajib untuk backend AVA
LOGIN_ID=useradmin1
USER_ID=585f37d3-6167-4cd6-84a3-17a9f7b2be90
BRANCH_ID=b879defe-ee35-4314-9a46-4b87ef6216e7

# S9 Order Integrity: persentase kirim partnerRefNo duplikat (0.0 = mati, 0.05 = 5% duplikat)
DUPLICATE_REF_RATE=0.0

# ------------------------------------------
# Config Auth BI-SNAP (isi jika ENABLE_AUTH=true)
# ------------------------------------------
TOKEN_PATH=/v1.0/access-token/b2b
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
PARTNER_ID=GCASH
PRIVATE_KEY_PATH=keys/private_key.pem
TOKEN_REFRESH_SECONDS=800

# ------------------------------------------
# Default master data untuk payload write
# ------------------------------------------
DEFAULT_SALES_ID=46aaeb86-007f-4d72-b346-13ae9b514793
DEFAULT_BRANCH_ID=b879defe-ee35-4314-9a46-4b87ef6216e7
DEFAULT_BANK_ID=46aaeb86-007f-4d72-b346-13ae9b514793
REDEMPTION_BY_UNIT=5.0
